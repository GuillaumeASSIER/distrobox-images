{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Paris",
  "nix": {
    "enabled": true
  },
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "groupName": "nix-dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "ci-github-actions",
      "pinDigests": true,
      "schedule": ["every 2 weeks on Monday"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
